# Copy this file to .env and fill in real values. Never commit .env itself.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Used to build confirm/unsubscribe links in emails. Change if you deploy
# somewhere other than your own machine.
SITE_BASE_URL=http://127.0.0.1:8000

# Leave RESEND_API_KEY blank to test locally: emails print to the console
# instead of actually sending.
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=Broadhead Brief <newsletter@yourdomain.com>

# Timezone used for "week of" calculations (must be an IANA name).
DJANGO_TIME_ZONE=America/Chicago
